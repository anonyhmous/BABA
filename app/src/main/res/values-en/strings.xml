    <!-- Welcome Screen -->
    <string name="welcome_page1_title">Hello Captain</string>
    <string name="welcome_page1_desc">DriveFlow is built to protect your hard work, car/motorcycle and fuel. It calculates true net earnings for each ride before you accept or counter-offer.</string>
    <string name="welcome_page2_title">A Verdict at a Glance</string>
    <string name="welcome_page2_desc">A clear colored badge appears instantly beside each request:\n  Green: Great profitable ride\n  Orange: Needs negotiation or caution\n  Red: Loss-making, skip it\n  Gray: Waiting for distance details.</string>
    <string name="welcome_page3_title">Trips on Your Terms</string>
    <string name="welcome_page3_desc">You set your minimum price per km, your preferred drop-off neighborhoods, and avoided zones, with auto calculation of company commission, fuel, and upkeep for cars and motorcycles.</string>
    <string name="welcome_page4_title">Good Requests Call You with Sound</string>
    <string name="welcome_page4_desc">No need to stare at the screen all day. When a top-tier ride meeting all your rules appears, DriveFlow chimes and vibrates immediately.</string>
    <string name="welcome_page5_title">You Are in Full Control</string>
    <string name="welcome_page5_desc">The app only reads the screen! It NEVER clicks, accepts, rejects, or negotiates on your behalf. The decision is always 100% yours.</string>
    <string name="welcome_page6_title">How to Subscribe &amp; Run</string>
    <string name="welcome_page6_desc">Serverless and offline. Transfer the fee via InstaPay, send your device code on WhatsApp, and receive your offline license key.</string>
    <string name="btn_skip">Skip</string>
    <string name="btn_next">Next</string>
    <string name="btn_get_started">Get Started</string>

    <!-- Consent Screen -->
    <string name="consent_title">What does DriveFlow read?</string>
    <string name="consent_subtitle">Full transparency and driver privacy</string>
    <string name="consent_point1_title">Reads only supported ride apps</string>
    <string name="consent_point1_desc">Reads trip price, distance, rider rating, pickup and dropoff addresses from inDrive, Uber Driver, and DiDi Driver only.</string>
    <string name="consent_point2_title">Never touches or taps the screen</string>
    <string name="consent_point2_desc">The app has no auto-clicking capabilities. It never accepts, rejects, or interferes with other apps.</string>
    <string name="consent_point3_title">No rider data is stored</string>
    <string name="consent_point3_desc">All calculations are strictly transient in memory. No rider names, phone numbers, or trips are recorded.</string>
    <string name="consent_point4_title">Full privacy, no servers</string>
    <string name="consent_point4_desc">There is no backend server. Nothing leaves your phone except messages you choose to send to the owner via WhatsApp.</string>
    <string name="btn_agree_continue">I Agree and Continue</string>
    <string name="btn_view_commitments">Read Full Commitments</string>

