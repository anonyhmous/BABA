    <!-- Help & About Screen -->
    <string name="help_title">Help &amp; Support</string>
    <string name="how_it_works_title">How DriveFlow Works</string>
    <string name="pillar1_title">1. Colored badge beside each request</string>
    <string name="pillar1_desc">Instant calculation of price per KM and clear visual indicator.</string>
    <string name="pillar2_title">2. Floating summary bar</string>
    <string name="pillar2_desc">A subtle bar over the map showing net profit, total trip distance, and instant switching between full trip or base trip calculation.</string>
    <string name="pillar3_title">3. You decide</string>
    <string name="pillar3_desc">DriveFlow never clicks, accepts, or rejects for you.</string>
    <string name="pillar4_title">4. Sound alerts while driving</string>
    <string name="pillar4_desc">Distinct chime for golden requests without distracting your vision.</string>
    <string name="legend_title">Color Legend:</string>
    <string name="legend_green">Green: Accept, highly profitable trip meeting all rules.</string>
    <string name="legend_orange">Orange: Think first &amp; negotiate, low rate or extra stop.</string>
    <string name="legend_red">Red: Skip, loss-making or avoided neighborhood.</string>
    <string name="legend_gray">Gray: Waiting for distance OCR and trip details.</string>
