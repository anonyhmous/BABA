    <!-- Commitments Screen -->
    <string name="commitments_heading">Things DriveFlow Never Does</string>
    <string name="commit1_title">1. Never taps or clicks</string>
    <string name="commit1_desc">The app never taps, accepts, rejects, or negotiates on your behalf. You remain in complete control.</string>
    <string name="commit2_title">2. Never stores rider details</string>
    <string name="commit2_desc">We do not store or persist rider names, locations, or passenger information.</string>
    <string name="commit3_title">3. No server connections</string>
    <string name="commit3_desc">DriveFlow runs completely offline on your device and sends zero data to external servers.</string>
    <string name="commit4_title">4. Transparent subscription</string>
    <string name="commit4_desc">Manual renewal through InstaPay with no surprise auto-billing.</string>

